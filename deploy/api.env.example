# systemd EnvironmentFile syntax, not a shell script. Install root-owned mode 0600.
HIMA_BIND_ADDR=127.0.0.1:3000
HIMA_PUBLIC_ORIGIN=https://hima.example
HIMA_OIDC_ISSUER=https://id.example/realms/hima
HIMA_OIDC_CLIENT_ID=hima
# HIMA_OIDC_CLIENT_SECRET=replace-with-provider-secret
DATABASE_URL=postgres://hima:replace-with-url-encoded-password@127.0.0.1:5432/hima
RUST_LOG=info
