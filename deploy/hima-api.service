[Unit]
Description=hima account and planner API
Wants=network-online.target
After=network-online.target
Requires=hima-migrate.service
After=hima-migrate.service

[Service]
Type=simple
User=hima
Group=hima
EnvironmentFile=/etc/hima/api.env
ExecStart=/opt/hima/current/backend/bin/hima-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
# OIDC endpoints and DNS require site-specific IP allowlists; see deploy/README.md.
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
