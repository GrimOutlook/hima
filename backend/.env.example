# Local development only. Copy to backend/.env and source with set -a.
# The backend does not automatically load dotenv files.
HIMA_BIND_ADDR=127.0.0.1:3000
RUST_LOG=info
DATABASE_URL=postgres://postgres:hima-dev@127.0.0.1:5432/hima
HIMA_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Replace with the exact discovery issuer of your local OIDC provider.
HIMA_OIDC_ISSUER=http://127.0.0.1:8080/realms/hima
HIMA_OIDC_CLIENT_ID=hima-dev
# Public Authorization Code + S256 PKCE client: no secret needed.
# For a confidential client, set its secret only in backend/.env.
# HIMA_OIDC_CLIENT_SECRET=
